{
  "name": "daleel",
  "version": "0.6.0",
  "description": "Daleel (دليل) — scan a codebase for Saudi DGA (Digital Government Authority) design-system readiness: RTL-first, IBM Plex Sans Arabic, WCAG 2.1 AA. AST-verified, report-only, plus an optional HarfBuzz `--render` font-proof (covers + joins Arabic, no tofu). Part of Otto.",
  "bin": {
    "daleel": "bin/daleel.js",
    "dls-check": "bin/daleel.js",
    "daleel-mcp": "mcp/daleel-mcp.js"
  },
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/run.js test/wcag.test.js test/license.test.js"
  },
  "keywords": [
    "dga",
    "daleel",
    "dls-check",
    "saudi",
    "design-system",
    "compliance",
    "rtl",
    "wcag",
    "arabic",
    "gov",
    "linter",
    "harfbuzz",
    "shaping",
    "font-proof"
  ],
  "author": "Othmane Morad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Otto-OttoSpace/daleel.git"
  },
  "homepage": "https://github.com/Otto-OttoSpace/daleel#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "lib",
    "mcp",
    "assets",
    "action.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
